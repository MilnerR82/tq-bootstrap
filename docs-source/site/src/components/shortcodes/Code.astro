---
import fs from 'node:fs'
import path from 'node:path'
import { Prism } from '@astrojs/prism'

interface Props {
  /**
   * The CSS class(es) to be added to the `pre` HTML element when rendering code blocks in Markdown.
   * Note that this prop is not used when the component is invoked directly.
   */
  class?: string
  /**
   * The code to highlight.
   * If an array is passed, elements will be joined with a new line.
   */
  code?: string | string[]
  /**
   * The CSS class(es) to be added to the `div` wrapper HTML element.
   */
  containerClass?: string
  /**
   * The language to use for highlighting.
   * @see https://prismjs.com/#supported-languages
   */
  lang?: string
  /**
   * If the `filePath` prop is defined, this prop can be used to specify a regex containing a match group to extract
   * only a part of the file.
   */
  fileMatch?: string
  /**
   * A path to the file containing the code to highlight relative to the root of the repository.
   * This takes precedence over the `code` prop.
   */
  filePath?: string
  /**
   * Defines if the `<Code>` component is nested inside an `<Example>` component or not.
   * @default false
   */
  nestedInExample?: boolean
}

const { class: className, code, containerClass, fileMatch, filePath, lang, nestedInExample = false } = Astro.props

let codeToDisplay = filePath
  ? fs.readFileSync(path.join(process.cwd(), filePath), 'utf8')
  : Array.isArray(code)
    ? code.join('\n')
    : code

if (filePath && fileMatch && codeToDisplay) {
  const match = codeToDisplay.match(new RegExp(fileMatch))

  if (!match || !match[0]) {
    throw new Error(`The file at ${filePath} does not contains a match for the regex '${fileMatch}'.`)
  }

  codeToDisplay = match[0]
}
---

<script>
  import ClipboardJS from 'clipboard'

  // Only genuine scrolling regions need an additional Tab stop. Reassess after viewport, font or text resizing.
  const codeRegions = document.querySelectorAll<HTMLElement>('.highlight[data-tq-code-label] > pre')
  const updateCodeRegion = (pre: HTMLElement) => {
    const scrolls = pre.scrollWidth > pre.clientWidth + 1 || pre.scrollHeight > pre.clientHeight + 1
    if (scrolls) {
      pre.tabIndex = 0
      pre.setAttribute('role', 'region')
      pre.setAttribute('aria-label', pre.parentElement?.dataset.tqCodeLabel || 'Code example; scroll horizontally to read all code')
      pre.dataset.tqScrollableCode = 'true'
    } else if (pre.dataset.tqScrollableCode) {
      pre.removeAttribute('tabindex')
      pre.removeAttribute('role')
      pre.removeAttribute('aria-label')
      delete pre.dataset.tqScrollableCode
    }
  }
  const codeObserver = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const target = entry.target as HTMLElement
      updateCodeRegion(target.tagName === 'PRE' ? target : target.parentElement!)
    }
  })
  codeRegions.forEach((pre) => {
    updateCodeRegion(pre)
    codeObserver.observe(pre)
    if (pre.firstElementChild) codeObserver.observe(pre.firstElementChild)
  })
  let codeUpdateFrame = 0
  const scheduleCodeRegions = () => {
    if (codeUpdateFrame) return
    codeUpdateFrame = requestAnimationFrame(() => {
      codeUpdateFrame = 0
      codeRegions.forEach(updateCodeRegion)
    })
  }
  // Inline CODE can change intrinsic width without resizing its PRE. User stylesheets
  // must therefore trigger a new overflow measurement as well as ResizeObserver.
  new MutationObserver(scheduleCodeRegions).observe(document.head, {
    childList: true,
    subtree: true,
    characterData: true,
    attributes: true,
    attributeFilter: ['href', 'media', 'disabled', 'style']
  })
  const codeStyleObserver = new MutationObserver(scheduleCodeRegions)
  for (const element of [document.documentElement, document.body]) {
    codeStyleObserver.observe(element, { attributes: true, attributeFilter: ['style', 'class'] })
  }
  document.addEventListener('load', (event) => {
    if (event.target instanceof HTMLLinkElement && event.target.rel === 'stylesheet') scheduleCodeRegions()
  }, true)
  // Also measure before native Tab navigation, covering CSSOM changes with no DOM mutation.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') codeRegions.forEach(updateCodeRegion)
  }, true)
  document.fonts.ready.then(scheduleCodeRegions)
  document.fonts.addEventListener('loadingdone', scheduleCodeRegions)
  window.addEventListener('resize', scheduleCodeRegions)

  const btnTitle = 'Copy to clipboard'
  const btnEdit = 'Edit on StackBlitz'

  function snippetButtonTooltip(selector: string, title: string) {
    document.querySelectorAll(selector).forEach((btn) => {
      window.TQAccessibility.createTooltip(btn, { title })
    })
  }

  snippetButtonTooltip('.btn-clipboard', btnTitle)
  snippetButtonTooltip('.btn-edit', btnEdit)

  const clipboardStatus = document.querySelector<HTMLElement>('[data-tq-clipboard-status]') || document.createElement('p')
  clipboardStatus.className = 'visually-hidden'
  clipboardStatus.dataset.tqClipboardStatus = 'true'
  clipboardStatus.setAttribute('role', 'status')
  clipboardStatus.setAttribute('aria-live', 'polite')
  clipboardStatus.setAttribute('aria-atomic', 'true')
  if (!clipboardStatus.isConnected) document.body.append(clipboardStatus)
  let clipboardAnnouncementFrame = 0
  const announceClipboard = (message: string) => {
    if (clipboardAnnouncementFrame) cancelAnimationFrame(clipboardAnnouncementFrame)
    clipboardStatus.textContent = ''
    clipboardAnnouncementFrame = requestAnimationFrame(() => {
      clipboardAnnouncementFrame = 0
      clipboardStatus.textContent = message
    })
  }

  const clipboard = new ClipboardJS('.btn-clipboard', {
    target: (trigger) => trigger.closest('.bd-code-snippet')?.querySelector('.highlight')!,
    text: (trigger) => {
      // Trim text to workaround a Firefox issue where the structure of the DOM (uncontrolled) is relevant for the
      // copied text.
      // https://github.com/zenorocha/clipboard.js/issues/439#issuecomment-312344621
      return trigger.closest('.bd-code-snippet')?.querySelector('.highlight')!.textContent?.trim()!
    }
  })

  clipboard.on('success', (event) => {
    announceClipboard('Code copied to clipboard.')
    event.clearSelection()
    const iconFirstChild = event.trigger.querySelector('.bi')?.firstElementChild
    const tooltipBtn = bootstrap.Tooltip.getInstance(event.trigger)
    const namespace = 'http://www.w3.org/1999/xlink'
    const originalXhref = iconFirstChild?.getAttributeNS(namespace, 'href')
    const isCheckIconVisible = originalXhref === '#check2'

    if (isCheckIconVisible) {
      return
    }

    tooltipBtn?.setContent({ '.tooltip-inner': 'Copied!' })

    event.trigger.addEventListener(
      'hidden.bs.tooltip',
      () => {
        tooltipBtn?.setContent({ '.tooltip-inner': btnTitle })
      },
      { once: true }
    )

    if (originalXhref) {
      iconFirstChild?.setAttributeNS(namespace, 'href', originalXhref.replace('clipboard', 'check2'))
    }

    setTimeout(() => {
      if (originalXhref) {
        iconFirstChild?.setAttributeNS(namespace, 'href', originalXhref)
      }
    }, 2000)
  })

  clipboard.on('error', (event) => {
    const modifierKey = /mac/i.test(navigator.userAgent) ? '\u2318' : 'Ctrl-'
    const fallbackMsg = `Press ${modifierKey}C to copy`
    announceClipboard(`Copy was not completed. ${fallbackMsg}.`)
    const tooltipBtn = bootstrap.Tooltip.getInstance(event.trigger)

    tooltipBtn?.setContent({ '.tooltip-inner': fallbackMsg })

    event.trigger.addEventListener(
      'hidden.bs.tooltip',
      () => {
        tooltipBtn?.setContent({ '.tooltip-inner': btnTitle })
      },
      { once: true }
    )
  })
</script>

<div class:list={[{ 'bd-code-snippet': !nestedInExample }, containerClass]}>
  {
    nestedInExample
      ? (<></>)
      : Astro.slots.has('pre')
        ? (
          <slot name="pre" />
        )
        : (
          <div class="bd-clipboard">
            <button type="button" class="btn-clipboard">
              <svg class="bi" role="img" aria-label="Copy">
                <use xlink:href="#clipboard" />
              </svg>
            </button>
          </div>
        )
  }
  <div class="highlight" data-tq-code-label={filePath ? `Code from ${filePath}; scroll horizontally to read all code` : `${lang || 'Code'} example; scroll horizontally to read all code`}>
    {
      codeToDisplay && lang ? (
        <Prism code={codeToDisplay} lang={lang} />
      ) : (
        /* prettier-ignore */ <pre class={className}><slot /></pre>
      )
    }
  </div>
</div>
