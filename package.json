{
  "name": "tq-bootstrap",
  "version": "1.0.0",
  "private": true,
  "description": "Bootstrap 5.3.8 source, website and JavaScript with a TAFE Queensland Sass theme",
  "type": "module",
  "scripts": {
    "setup:upstream": "node scripts/acquire-upstream.mjs",
    "build": "node scripts/build.mjs",
    "build:docs": "node docs-source/build-tq-docs.mjs",
    "publish:docs": "node scripts/publish-docs.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node qa/compiled-parity.mjs",
    "test:docs": "node qa/docs-colour-parity.mjs",
    "test:examples": "node qa/examples-colour-parity.mjs",
    "test:sass": "node qa/sass-customisation.mjs",
    "test:rendered": "node qa/rendered-parity.mjs",
    "test:integrity": "node scripts/verify-package.mjs",
    "test:portability": "node qa/package-portability.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.21",
    "browserslist": "4.25.3",
    "caniuse-lite": "1.0.30001735",
    "clean-css": "5.3.3",
    "esbuild": "0.28.1",
    "htmlparser2": "10.0.0",
    "postcss": "8.5.6",
    "rtlcss": "4.3.0",
    "sass": "1.93.2"
  }
}
